# Always install devDependencies, even when NODE_ENV=production.
#
# Render (and most PaaS hosts) set NODE_ENV=production during the build, which
# makes npm omit devDependencies. But `next build` needs several of them —
# typescript, tailwindcss, @tailwindcss/postcss and the @types/* packages — so
# a production-mode install produces a tree that cannot compile.
#
# Setting this here rather than in the host's build command keeps the build
# reproducible: `npm install` does the right thing wherever it runs.
include=dev
