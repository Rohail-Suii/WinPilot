# ─────────────────────────────────────────────────────────────
# WinPilot — production environment TEMPLATE.
#
# Copy to .env.production (gitignored) and fill in the blanks, then paste the
# same values into the Render dashboard under
#   Service → Environment → Environment Variables.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time, so they
# must exist in Render before the build runs, not just at runtime.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=production
# PORT is injected by the host (Render) — do not set it manually.
# WS_PORT is intentionally unset: Socket.IO shares the app's port at /api/ws.

# ── Database ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/linkedboost?retryWrites=true&w=majority

# ── NextAuth ──
NEXTAUTH_URL=https://winpilot.onrender.com
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# ── Encryption ──
# WARNING: this key decrypts the API keys already stored in MongoDB. Never
# rotate it on a live deploy — every saved user API key becomes undecryptable.
# generate a new one with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# ── OAuth ──
# Add this redirect URI in Google Cloud Console → Credentials → OAuth client:
#   https://winpilot.onrender.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WebSocket ──
# Same origin as the app: Socket.IO is mounted on the Next.js server at /api/ws.
NEXT_PUBLIC_WS_URL=https://winpilot.onrender.com
WS_ALLOWED_ORIGINS=https://winpilot.onrender.com,https://www.linkedin.com

# ── CORS (extension → API) ──
CORS_ORIGIN=https://www.linkedin.com

# ── Email ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=Winpilot <noreply@example.com>

# ── OpenRouter attribution (optional) ──
OPENROUTER_HTTP_REFERER=https://winpilot.onrender.com
OPENROUTER_APP_TITLE=WinPilot

# ── Job-application email (Gmail SMTP) ──
# Applications found on the feed are sent from a real Gmail account over
# authenticated SMTP, so they are DKIM-signed by Google and align for DMARC.
# That is the single biggest reason they land in the inbox rather than Spam.
#
# Requires a Google APP PASSWORD, not the account password: turn on 2-Step
# Verification, then Account → Security → App passwords → Mail.
#
# These are a DEPLOYMENT-WIDE FALLBACK only. A user who connects their own
# account in Settings → Applications always sends as themselves; this account
# is used when they have not. Leave both blank on a multi-user deployment.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The sender's clock, in server.ts. Set to "false" to keep the feature in the
# UI but stop anything going out. Each pass sends at most one application per
# user; the per-user "minutes between sends" setting is the real spacing.
OUTREACH_ENABLED=true
# Milliseconds between sender passes. Minimum 30000. Leave unset in production.
# OUTREACH_TICK_MS=120000

# ── Feature flags ──
ENFORCE_DAILY_LIMITS=true

# ── Autopilot ──
# The autonomous scheduler runs inside server.ts (not a Next route), so it only
# exists on hosts that boot via `npm start`. Set to "false" to keep the feature
# in the UI but stop the clock — nothing will be dispatched.
AUTOPILOT_ENABLED=true
# Milliseconds between planner passes. Minimum 5000; anything lower is ignored.
# Leave unset in production — the 5-minute default is what the pacing and
# cooldown maths assume. Lower it only for local smoke tests.
# AUTOPILOT_TICK_MS=300000
