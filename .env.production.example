# ─────────────────────────────────────────────────────────────
# WinPilot — production environment TEMPLATE.
#
# Copy to .env.production (gitignored) and fill in the blanks, then paste the
# same values into the Render dashboard under
#   Service → Environment → Environment Variables.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time, so they
# must exist in Render before the build runs, not just at runtime.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=production
# PORT is injected by the host (Render) — do not set it manually.
# WS_PORT is intentionally unset: Socket.IO shares the app's port at /api/ws.

# ── Database ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/linkedboost?retryWrites=true&w=majority

# ── NextAuth ──
NEXTAUTH_URL=https://winpilot.onrender.com
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# ── Encryption ──
# WARNING: this key decrypts the API keys already stored in MongoDB. Never
# rotate it on a live deploy — every saved user API key becomes undecryptable.
# generate a new one with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# ── OAuth ──
# Add this redirect URI in Google Cloud Console → Credentials → OAuth client:
#   https://winpilot.onrender.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WebSocket ──
# Same origin as the app: Socket.IO is mounted on the Next.js server at /api/ws.
NEXT_PUBLIC_WS_URL=https://winpilot.onrender.com
WS_ALLOWED_ORIGINS=https://winpilot.onrender.com,https://www.linkedin.com

# ── CORS (extension → API) ──
CORS_ORIGIN=https://www.linkedin.com

# ── Email ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=Winpilot <noreply@example.com>

# ── OpenRouter attribution (optional) ──
OPENROUTER_HTTP_REFERER=https://winpilot.onrender.com
OPENROUTER_APP_TITLE=WinPilot

# ── Feature flags ──
ENFORCE_DAILY_LIMITS=true
