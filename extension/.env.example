# ─────────────────────────────────────────────────────────────
# WinPilot browser extension — build-time configuration.
#
# Copy to extension/.env (gitignored) and set the backend this build should
# talk to. The value is baked into dist/ when you run the build, so switching
# environments means editing this file and rebuilding:
#
#   cd extension && npm run build
#
# Precedence: --url= flag → shell env var → this file → production default.
# ─────────────────────────────────────────────────────────────

# Origin of the WinPilot web app (API + dashboard links). No trailing slash,
# no path. Examples:
#   http://localhost:3000
#   https://winpilot.onrender.com
#   https://winpilot.tech
WINPILOT_APP_URL=https://winpilot.onrender.com

# Optional. Socket.IO is mounted on the app's own server at /api/ws, so this
# only needs setting if the WebSocket server ever moves to a separate host.
# Defaults to WINPILOT_APP_URL.
# WINPILOT_WS_URL=https://winpilot.onrender.com
